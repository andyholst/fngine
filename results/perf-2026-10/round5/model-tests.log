```c
#include <stddef.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;

Node *reverseLinkedList(Node *head) {
    Node *prev = NULL;
    Node *current = head;

    while (current != NULL) {
        Node *next = current->next;
        current->next = prev;
        prev = current;
        current = next;
    }

    return prev;
}
```

This function reverses a singly linked list iteratively and returns the new head.


