  "runtime_changes": [
   {
    "path": "src/kernels/moe/moe_decode.cu",
    "symbol": "hot_gate_up_kernel",
    "description": "Persistent grid (SMs x occupancy CTAs) over (work item, 8-row) tiles. Each warp keeps one tile buffer, streamed in five K slices: once slice i of the current tile is decoded, slice i - 1 of the next tile is requested into the space of the current tile's slice i - 1; the one-slice gap keeps it clear of slices still in flight for any 16-byte row alignment. Work list in shared memory; per-lane arithmetic and summation order unchanged.",
    "source_sha256": "0b48c0df8aaab95da07aefdab412117bb8c96144bae682c0e96376302f601702"
   },
   {
    "path": "src/kernels/moe/moe_decode.cu",
    "symbol": "hot_down_kernel",
    "description": "Persistent grid of 128-thread CTAs over contiguous ranges of (work item, 32-row) tiles, two cp.async stages in dynamic shared memory, h quantized to q8 once per item per CTA (previously once per 64-row tile); pdl_trigger() first.",
    "source_sha256": "0b48c0df8aaab95da07aefdab412117bb8c96144bae682c0e96376302f601702"
   },
